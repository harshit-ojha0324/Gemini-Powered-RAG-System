# Google Gemini API Key
# Get your FREE API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding model, read once at startup: "local" for the offline
# sentence-transformers model, or a Gemini embedding model. Unset: Gemini
# (models/gemini-embedding-001) when GEMINI_API_KEY is set, otherwise local.
# EMBEDDING_MODEL=local

# Chroma vector store location (relative to backend/)
CHROMA_PERSIST_DIRECTORY=./data/vectorstore
